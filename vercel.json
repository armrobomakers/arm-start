{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "arm-start.vercel.app" }],
      "destination": "https://start.robomakers.org/",
      "permanent": true
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [{ "type": "host", "value": "arm-start.vercel.app" }],
      "destination": "https://start.robomakers.org/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet" }
      ]
    }
  ]
}
